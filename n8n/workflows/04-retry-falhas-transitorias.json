{
  "name": "Meteórico - WA - Retry de Falhas Transitórias",
  "id": "meteoricoWaRetry",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] } },
      "id": "schedule-retry",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.METEORICO_API_INTERNAL_URL + '/internal/followup/retry-due'}}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.N8N_INTERNAL_TOKEN}}" }] },
        "options": { "timeout": 120000 }
      },
      "id": "retry-due",
      "name": "Reprocessar somente transitórias",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0]
    }
  ],
  "connections": { "A cada 5 minutos": { "main": [[{ "node": "Reprocessar somente transitórias", "type": "main", "index": 0 }]] } },
  "active": true,
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none", "timezone": "America/Belem" },
  "versionId": "00000000-0000-4000-8000-000000000004",
  "meta": { "templateCredsSetupCompleted": false },
  "tags": []
}
