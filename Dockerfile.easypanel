FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate
WORKDIR /app

FROM base AS build
ENV PNPM_CONFIG_TRUST_LOCKFILE=true
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/worker/package.json ./apps/worker/
COPY packages/shared/package.json ./packages/shared/
COPY packages/domain/package.json ./packages/domain/
COPY packages/database/package.json ./packages/database/
COPY packages/ui/package.json ./packages/ui/
RUN --mount=type=cache,id=meteorico-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod=false --trust-lockfile
COPY . .
RUN pnpm --filter @meteorico/shared run build && \
    pnpm --filter @meteorico/domain run build && \
    pnpm --filter @meteorico/database run generate && \
    pnpm --filter @meteorico/database run build && \
    pnpm --filter @meteorico/api run build && \
    pnpm --filter @meteorico/worker run build && \
    pnpm --filter @meteorico/ui run build && \
    pnpm --filter @meteorico/web run build

FROM base AS api
RUN addgroup -g 1001 -S meteorico && adduser -S meteorico -u 1001
WORKDIR /app
COPY --from=build --chown=meteorico:meteorico /app .
USER meteorico
ENV NODE_ENV=production
EXPOSE 4080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4080/health || exit 1
CMD ["node", "apps/api/dist/server.js"]

FROM base AS worker
RUN addgroup -g 1001 -S meteorico && adduser -S meteorico -u 1001
WORKDIR /app
COPY --from=build --chown=meteorico:meteorico /app .
USER meteorico
ENV NODE_ENV=production
EXPOSE 4081
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4081/ || exit 1
CMD ["node", "apps/worker/dist/main.js"]

FROM nginx:alpine AS web
RUN sed -i 's|^pid .*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf && \
    mkdir -p /etc/nginx/templates && \
    chown -R nginx:nginx /var/cache/nginx /etc/nginx/conf.d /etc/nginx/templates
COPY --chown=nginx:nginx --from=build /app/apps/web/dist /usr/share/nginx/html
COPY --chown=nginx:nginx apps/web/nginx.conf /etc/nginx/templates/default.conf.template
ENV API_PROXY_HOST=api
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/ || exit 1
