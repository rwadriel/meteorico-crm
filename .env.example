# Database
DATABASE_URL=postgresql://meteorico:meteorico_dev@localhost:5432/meteorico_crm

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4080
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:5173

# Web
VITE_API_URL=http://localhost:4080

# Worker
WORKER_POLLING_INTERVAL_MS=10000
GROUP_MANAGER_SNAPSHOT_STALE_AFTER_SECONDS=

# Deployment environment (development, staging, production)
DEPLOYMENT_ENV=development

# Timezone
TZ=America/Belem

# Security (change in production)
SESSION_SECRET=
COOKIE_DOMAIN=localhost
ENCRYPTION_KEY=

# Seed admin (development only)
SEED_ADMIN_EMAIL=admin@meteorico.dev
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin Dev

# WhatsApp Manager Integration (mock in development)
WHATSAPP_MANAGER_URL=http://localhost:4040
WHATSAPP_MANAGER_INTEGRATION_TOKEN=

# WhatsApp Messaging Provider
WHATSAPP_PRIVATE_PROVIDER=mock
# Fail-closed kill switch. Enable only during an explicitly approved send window.
WHATSAPP_OUTBOUND_ENABLED=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
WHATSAPP_STAGING_ALLOWLIST=

# AI Provider (not used until Etapa 08)
# XAI_API_KEY=

# Eduzz (not used until Etapa 09)
# EDUZZ_CLIENT_ID=
# EDUZZ_CLIENT_SECRET=
EDUZZ_WEBHOOK_SECRET=
