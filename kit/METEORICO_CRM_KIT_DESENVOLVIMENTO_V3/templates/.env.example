# Copie para .env apenas no ambiente local. Nunca versione o .env real.
NODE_ENV=development
TZ=America/Belem

# URLs
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database / cache
DATABASE_URL=postgresql://meteorico:meteorico@postgres:5432/meteorico
REDIS_URL=redis://redis:6379

# Auth
SESSION_SECRET=replace-with-long-random-development-value
CSRF_SECRET=replace-with-long-random-development-value

# WhatsApp Manager (somente leitura)
WHATSAPP_MANAGER_BASE_URL=https://example.invalid
WHATSAPP_MANAGER_INTEGRATION_TOKEN=
WHATSAPP_MANAGER_POLL_INTERVAL_MS=10000

# Provedor de mensagens privadas do WhatsApp
WHATSAPP_PROVIDER=mock
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# API externa de participações
PARTICIPATIONS_API_BASE_URL=
PARTICIPATIONS_API_TOKEN=

# Eduzz
EDUZZ_API_BASE_URL=
EDUZZ_CLIENT_ID=
EDUZZ_CLIENT_SECRET=
EDUZZ_WEBHOOK_SECRET=

# xAI / Grok
AI_PROVIDER=mock
XAI_API_KEY=
XAI_MODEL=
XAI_TIMEOUT_MS=20000
XAI_MAX_TOKENS=500

# Meta Ads / atribuição
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=

# Observabilidade
LOG_LEVEL=info
SENTRY_DSN=

# Desenvolvimento / seed - apenas valores fictícios
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=change-only-in-local-env
