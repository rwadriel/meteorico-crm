# Copie para .env e preencha.

# URL do WhatsApp Manager (sem barra no final)
WM_BASE=https://zapgrupos-whatsapp-manager.gq2dju.easypanel.host

# Token de integração (o mesmo WHATSAPP_MANAGER_INTEGRATION_TOKEN do EasyPanel)
WM_TOKEN=cole_seu_token_aqui

# Intervalo entre leituras do feed, em segundos (padrão 10)
INTERVALO=10

# Começar do zero (importar todo o histórico) ou só do presente?
#   0 = só novos a partir de agora
#   1 = importa todos os leads que já entraram (backfill)
IMPORTAR_HISTORICO=1

# Porta do painel web
PORTA=4080
